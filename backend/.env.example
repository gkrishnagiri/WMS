APP_NAME=Enterprise Operations Suite
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8050
BACKEND_CORS_ORIGINS=http://localhost:4001,http://127.0.0.1:4001,http://localhost:4011,http://127.0.0.1:4011,http://localhost:4012,http://127.0.0.1:4012,http://localhost:4013,http://127.0.0.1:4013,http://localhost:4014,http://127.0.0.1:4014,http://localhost:4015,http://127.0.0.1:4015

# Local development uses the Compose host-mapped PostgreSQL port.
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_NAME=wms
DATABASE_USER=wms
DATABASE_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# Prompt 13 local OpenTelemetry export is opt-in and safe when the collector is unavailable.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=eos-backend
OTEL_SERVICE_NAMESPACE=enterprise-operations-suite
OTEL_SERVICE_VERSION=0.1.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_ENABLED=true
OTEL_LOGS_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_SAMPLE_RATIO=1.0

# Prompt 20 governed real-model integration is disabled by default. Never
# commit a real key; OPENAI_API_KEY is read from the process environment only.
REAL_MODEL_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_REASONING_EFFORT=low
OPENAI_STORE_RESPONSES=false
