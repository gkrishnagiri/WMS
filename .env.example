# Local development environment
ENVIRONMENT=development

# Application
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=change-me
